# ============================================================================
# uFix BACKEND — sample environment file (2026-08-29)
# Copy to `.env` and fill real values:  cp .env.example .env
# `.env` is gitignored — NEVER commit real secrets. All values below are safe placeholders.
# Every var below is verified against backend/src code (no dead entries).
# ============================================================================

# ------------------------------ SERVER --------------------------------------
# Port the HTTP+Socket.io server listens on.
# Local: keep 5000. Render: DO NOT set (Render injects PORT automatically).
PORT=5000

# production | development
NODE_ENV=development

# ------------------------------ DATABASE ------------------------------------
# REQUIRED (server fails fast without it). Local dev shortcut: node dev-inmemory.js
# (in-memory Mongo, no .env needed at all).
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ufix
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ufix?retryWrites=true&w=majority

# OPTIONAL escape hatch: boot without a DB for health-check-only scenarios.
# Never for real traffic — all API data calls will fail.
# ALLOW_NO_DB=true

# ------------------------------ AUTH -----------------------------------------
# REQUIRED. Fresh 64-hex random, unique per environment. Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# (64 chars = plenty of entropy; a 128-bit key is the floor: 32 bytes -> 64 hex chars)
JWT_SECRET=replace_me_with_fresh_64_hex_chars

# OPTIONAL — Google Sign-In (frontend sends Google ID token; backend verifies with this).
# From: console.cloud.google.com -> Credentials -> OAuth Client ID (Web application).
# Without it, POST /api/auth/google returns a clear "not configured" error and Phone OTP
# remains the only login method.
GOOGLE_CLIENT_ID=

# ------------------------------ CORS -----------------------------------------
# REQUIRED in production: EXACT frontend origin — no trailing slash, no path, no wildcard.
# Local dev: http://localhost:5173
# Render+Netlify production: https://<your-netlify-site>.netlify.app
CLIENT_URL=http://localhost:5173

# ------------------------------ UPLOADS (Cloudinary) --------------------------
# OPTIONAL. Without these, image uploads fall back to a local mock (dev convenience).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------ ADMIN ----------------------------------------
# OPTIONAL but REQUIRED if you keep the admin provider-verify route enabled.
# Guards PATCH /api/providers/:id/verify via the x-admin-secret header.
# Use a fresh 64-hex random value (same generator as JWT_SECRET, DIFFERENT value).
# If unset, that admin route 404s by design.
ADMIN_SECRET=

# ------------------------------ SECURITY / TESTING ---------------------------
# ⚠️ NEVER SET IN PRODUCTION. Test-only bypass: skips ALL rate limiters so the local
# regression battery (dev-inmemory.js) can hammer endpoints. Production keeps limits ON
# (100 req/min/IP global, per-route ceilings, friendly 429s). If you see this set in a
# hosting dashboard, remove it immediately.
# RATE_LIMIT_DISABLED=true

# ------------------------------ NOTES ----------------------------------------
# - OTP expiry is 5 minutes, FIXED in code (Otp.js) — there is no env for it.
# - OTP SMS delivery: dev prints the OTP to server logs (and in NODE_ENV=development the
#   API echoes it for the test battery). Wire Twilio/Firebase Phone Auth before real users.
# - jwt token TTLs (access/refresh) are constants in src/utils/generateToken.js by design.
