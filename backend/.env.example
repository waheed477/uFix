PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ufix?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Phase 1 - Auth
JWT_SECRET=your_super_secure_jwt_secret_min_32_chars
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OTP - Simple OTP system chosen for Phase 1 (no external provider needed)
# If you want to use Twilio later, add these (currently NOT required):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# If you want to use Firebase Phone Auth later (alternative):
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# OTP Config
OTP_EXPIRY_MINUTES=5

# Phase 2 - Cloudinary (for profile pictures & verification docs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Phase 2 - Temporary admin verification
# Simple secret to protect PATCH /api/providers/:id/verify route
# If not set, route is open with warning (for testing) - set for basic protection
# Required in production if you keep the admin provider-verify route (it 404s without it).
# Use a STRONG, FRESH, UNIQUE random value - never this placeholder, never another env's value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

