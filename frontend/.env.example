# Frontend Environment Variables (Vite)
# Copy this file to .env and fill in values for local development

# Backend API base URL (REST)
# For local dev with backend running on port 5000:
VITE_API_URL=http://localhost:5000

# Socket.io URL (usually same as API URL, just ws:// will be handled automatically)
# If backend is on same origin, you can leave this same as API_URL, socket.io client will handle ws upgrade
VITE_SOCKET_URL=http://localhost:5000

# Optional: Cloudinary cloud name if you want direct uploads (not required, backend handles upload)
# VITE_CLOUDINARY_CLOUD_NAME=

# Optional: Google Maps API Key (for real Google Maps instead of custom SVG map)
# How to get: https://console.cloud.google.com/ -> APIs & Services -> Credentials -> Create API Key -> Enable Maps JavaScript API + Places API + Embed API
# If not set, app uses custom SVG map + OSM (free, no key) - works for all Pakistan cities
# If set, app will show real Google Maps centered on user's selected city
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

