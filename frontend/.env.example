# ============================================================================
# uFix FRONTEND — sample environment file (2026-08-29)
# Copy to `.env` and fill values:  cp .env.example .env
# All VITE_* vars are PUBLIC BY DESIGN — they are baked into the shipped browser bundle
# at build time. Never put secret keys here (there should never be any).
# Every var below is verified against frontend/src code (no dead entries).
# ============================================================================

# ------------------------------ REQUIRED ------------------------------------
# Backend API base URL (REST). Same value also powers the Socket.io client as fallback.
# Local dev (backend on port 5000):
VITE_API_URL=http://localhost:5000

# Production (Netlify/Vercel): set this to your Render service URL instead:
#   VITE_API_URL=https://<your-render-service>.onrender.com
# ⚠️ Bake-time value: changing it later requires a REDEPLOY (Netlify: trigger deploy).

# ------------------------------ OPTIONAL ------------------------------------
# Socket.io URL override — usually the SAME as VITE_API_URL; only set when the socket
# server genuinely lives on a different origin/port. If unset, socket client falls back
# to VITE_API_URL automatically (http/https -> ws/wss upgrade handled).
# VITE_SOCKET_URL=http://localhost:5000

# Google Maps API key — OPTIONAL. If unset, the app uses the built-in free solution
# (custom SVG map + OpenStreetMap) which covers all Pakistan cities with zero keys.
# To enable real Google Maps/Places:
#   console.cloud.google.com -> Credentials -> Create API Key
#   Enable: Maps JavaScript API, Places API, Maps Embed API
#   Restrict the key: HTTP referrers -> your Netlify domain.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------ NOTES ----------------------------------------
# - import.meta.env.DEV (built-in) gates dev-only UI (e.g. the Sound Preview panel);
#   it is automatically false in `vite build` — no env needed for that.
# - There are NO other env vars consumed by the frontend; if a feature needs one, add it
#   here AND in the deploy docs (docs/DEPLOYMENT.md) in the same change.
